  "foreignProductId": 2,
  "requestedQty": 30,
  "currentHoldingAtRequest": 30
}

> {%
    client.global.set("inboundIdMsft", response.body.data.inboundId);
    client.log("MSFT approvedQty = " + response.body.data.approvedQty);
%}

